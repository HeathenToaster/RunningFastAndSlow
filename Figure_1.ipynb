    "def make_mock_data(initial_value=1.0, slope=1.0, reward_effect=1.0, block=300):\n",
    "    idx = np.arange(3600)\n",
    "    alt_component = np.where((idx // block) % 2, reward_effect, 0)\n",
    "    y = initial_value + slope * idx + alt_component\n",
    "    smoothed_y = smooth(y, sigma=10)\n",
    "    return smoothed_y\n",
    "\n",
