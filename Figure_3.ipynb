    "\n",
    "    img = plt.imread(path)\n",
    "    img = img[300:2600, 150:3075]\n",
    "    img = np.concatenate((np.ones((300, img.shape[1], 3), dtype=np.uint8), img), axis=0)\n",
    "    \n",
    "    ax.imshow(img)\n",
    "    ax.axis(\"off\")\n",
    "    ax.text(s=r'$v_{\\mathrm{belt}}$ = 0 cm/s', x=img.shape[1]/2, y=1760, ha=\"center\", va=\"center\", fontsize=5)\n",
